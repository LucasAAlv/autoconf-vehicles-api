                        "body": null,
                        "description": "`VehiclePolicy::view` currently allows any authenticated user\nregardless of ownership, so this call trivially passes today \u2014 it is\nwired in now so a later issue that tightens the policy doesn't need\nto touch this controller."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"data\":{\"id\":44,\"placa\":\"NGZ0A03\",\"chassi\":\"MIYVDLJNIKH000003\",\"marca\":\"Chevrolet\",\"modelo\":\"Kicks\",\"versao\":\"1.6 Turbo\",\"valor_venda\":\"152854.40\",\"cor\":\"fuchsia\",\"km\":208376,\"cambio\":\"manual\",\"combustivel\":\"gasolina\",\"user_id\":76,\"created_at\":\"2026-08-06T22:24:39.000000Z\",\"updated_at\":\"2026-08-06T22:24:39.000000Z\",\"creator\":null,\"updater\":null,\"images\":[{\"id\":32,\"path\":\"vehicles\\\/763\\\/e660ec64-aeea-3ded-bfe4-fb1f468259dc.jpg\",\"url\":\"http:\\\/\\\/localhost:8000\\\/storage\\\/vehicles\\\/763\\\/e660ec64-aeea-3ded-bfe4-fb1f468259dc.jpg\",\"is_cover\":false,\"created_at\":\"2026-08-06T22:24:39.000000Z\",\"updated_at\":\"2026-08-06T22:24:39.000000Z\"}]}}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 401,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\",\"instance\":\"\\\/api\\\/vehicles\\\/1\"}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"detail\":\"The requested resource was not found.\",\"instance\":\"\\\/api\\\/vehicles\\\/999\"}",
                            "name": ""
