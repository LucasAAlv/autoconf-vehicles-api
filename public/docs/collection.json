                {
                    "name": "Update a vehicle",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/vehicles\/:vehicle_id",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/vehicles\/:vehicle_id",
                            "variable": [
                                {
                                    "id": "vehicle_id",
                                    "key": "vehicle_id",
                                    "value": 1,
                                    "description": "Id do ve\u00edculo."
                                }
                            ]
                        },
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"placa\":\"ABC1D23\",\"chassi\":\"9BWZZZ377VT004251\",\"marca\":\"Toyota\",\"modelo\":\"Corolla\",\"versao\":\"XEi 2.0\",\"valor_venda\":134900,\"cor\":\"Preto\",\"km\":18000,\"cambio\":\"automatico\",\"combustivel\":\"flex\"}"
                        },
                        "description": "Both `PUT` and `PATCH` route here and behave identically: every field in `UpdateVehicleRequest`\nis `sometimes`, so an absent field is simply left untouched by `fill()` rather than nulled out \u2014\nthere is no \"PUT replaces everything\" distinction. `updated_by` is not set by the controller \u2014\n`VehicleObserver` stamps it from the authenticated user on the `updating` event."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"data\":{\"id\":45,\"placa\":\"GZM0A04\",\"chassi\":\"IYVDLJNIKHW000004\",\"marca\":\"Ford\",\"modelo\":\"Cronos\",\"versao\":\"Comfortline\",\"valor_venda\":\"54132.38\",\"cor\":\"navy\",\"km\":237248,\"cambio\":\"manual\",\"combustivel\":\"gasolina\",\"user_id\":79,\"created_at\":\"2026-08-06T22:24:39.000000Z\",\"updated_at\":\"2026-08-06T22:24:39.000000Z\",\"creator\":null,\"updater\":null,\"images\":[{\"id\":33,\"path\":\"vehicles\\\/945\\\/f0b41b1f-4d8e-3b0d-b54e-b367d8431199.jpg\",\"url\":\"http:\\\/\\\/localhost:8000\\\/storage\\\/vehicles\\\/945\\\/f0b41b1f-4d8e-3b0d-b54e-b367d8431199.jpg\",\"is_cover\":false,\"created_at\":\"2026-08-06T22:24:39.000000Z\",\"updated_at\":\"2026-08-06T22:24:39.000000Z\"}]}}",
                            "name": "Ve\u00edculo atualizado. Campos ausentes no payload permanecem inalterados (PUT e PATCH se comportam de forma id\u00eantica)."
                        },
                        {
                            "header": [],
                            "code": 403,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"This action is unauthorized.\",\"instance\":\"\\\/api\\\/vehicles\\\/1\"}",
                            "name": "Usu\u00e1rio autenticado n\u00e3o \u00e9 o dono do ve\u00edculo nem `is_admin`."
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"detail\":\"The requested resource was not found.\",\"instance\":\"\\\/api\\\/vehicles\\\/999\"}",
                            "name": ""
