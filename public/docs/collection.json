                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "`VehiclePolicy::view` hoje permite qualquer usu\u00e1rio autenticado independentemente da\nposse, ent\u00e3o esta chamada sempre passa trivialmente \u2014 j\u00e1 est\u00e1 conectada agora para que\numa issue futura que restrinja a policy n\u00e3o precise tocar neste controller."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"data\":{\"id\":76,\"placa\":\"NGZ0A03\",\"chassi\":\"MIYVDLJNIKH000003\",\"marca\":\"Chevrolet\",\"modelo\":\"Kicks\",\"versao\":\"1.6 Turbo\",\"valor_venda\":\"152854.40\",\"cor\":\"fuchsia\",\"km\":208376,\"cambio\":\"manual\",\"combustivel\":\"gasolina\",\"user_id\":132,\"created_at\":\"2026-08-07T01:44:53.000000Z\",\"updated_at\":\"2026-08-07T01:44:53.000000Z\",\"creator\":null,\"updater\":null,\"images\":[{\"id\":56,\"path\":\"vehicles\\\/763\\\/e660ec64-aeea-3ded-bfe4-fb1f468259dc.jpg\",\"url\":\"http:\\\/\\\/localhost:8000\\\/storage\\\/vehicles\\\/763\\\/e660ec64-aeea-3ded-bfe4-fb1f468259dc.jpg\",\"is_cover\":false,\"created_at\":\"2026-08-07T01:44:53.000000Z\",\"updated_at\":\"2026-08-07T01:44:53.000000Z\"}]}}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 401,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"Unauthenticated.\",\"instance\":\"\\\/api\\\/vehicles\\\/1\"}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"detail\":\"O recurso solicitado n\\u00e3o foi encontrado.\",\"instance\":\"\\\/api\\\/vehicles\\\/999\"}",
                            "name": ""
                        }
                    ]
                },
                {
                    "name": "Atualizar um ve\u00edculo",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/vehicles\/:vehicle_id",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/vehicles\/:vehicle_id",
                            "variable": [
                                {
                                    "id": "vehicle_id",
                                    "key": "vehicle_id",
                                    "value": 1,
                                    "description": "Id do ve\u00edculo."
                                }
                            ]
                        },
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"placa\":\"ABC1D23\",\"chassi\":\"9BWZZZ377VT004251\",\"marca\":\"Toyota\",\"modelo\":\"Corolla\",\"versao\":\"XEi 2.0\",\"valor_venda\":134900,\"cor\":\"Preto\",\"km\":18000,\"cambio\":\"automatico\",\"combustivel\":\"flex\"}"
                        },
                        "description": "`PUT` e `PATCH` chegam ambos aqui e se comportam de forma id\u00eantica: todo campo em\n`UpdateVehicleRequest` \u00e9 `sometimes`, ent\u00e3o um campo ausente simplesmente permanece\nintocado pelo `fill()` em vez de ser zerado \u2014 n\u00e3o h\u00e1 distin\u00e7\u00e3o de \"PUT substitui tudo\".\n`updated_by` n\u00e3o \u00e9 setado pelo controller \u2014 `VehicleObserver` o carimba a partir do\nusu\u00e1rio autenticado no evento `updating`."
                    },
                    "response": [
                        {
